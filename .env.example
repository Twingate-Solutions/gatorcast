# Gatorcast — secrets only. Copy to .env and fill in. Never commit .env.

# Shared bearer token the log shipper presents to POST /ingest.
INGEST_TOKEN=change-me-long-random

# UI basic-auth credentials (single operator).
UI_AUTH_USERNAME=admin
UI_AUTH_PASSWORD=change-me

# --- Encryption at rest (optional, opt-in) ---
# Encrypt .cast recordings on the volume with AES-256-GCM. Off by default.
# The metadata database stays plaintext (documented limitation). Fresh-start
# only: enabling does NOT migrate existing unencrypted recordings.
ENCRYPTION_ENABLED=false

# Base64-encoded 32-byte master key. REQUIRED when ENCRYPTION_ENABLED=true —
# the app refuses to boot without a valid key (fail-closed).
# Generate one with:  openssl rand -base64 32
# WARNING: losing this key makes all encrypted .cast files unrecoverable.
# In production, pull it from a secrets vault (AWS Secrets Manager, HashiCorp
# Vault) and inject it as this env var rather than committing it.
# Note: the search/detection plaintext sidecars (<conn_id>.txt.enc) are encrypted
# with an independent key derived from this same master key (distinct HKDF info).
GATORCAST_MASTER_KEY=

# --- Search & automated detection (optional, all defaulted) ---
# Non-secret; usually set in docker-compose, listed here for completeness.
# Run dangerous-command + secret-exposure detection at finalize (produces findings).
DETECTION_ENABLED=true
# On startup, index + detect existing finalized recordings that lack a sidecar.
BACKFILL_ON_STARTUP=true
# Default number of search results per page.
SEARCH_PAGE_SIZE=50
# Max sidecars scanned per keyword/regex content search (ReDoS / cost bound).
SEARCH_REGEX_MAX_CANDIDATES=2000

# --- kubectl activity grouping (optional, all defaulted) ---
# Inactivity gap (seconds) that splits one user's kubectl activity sessions.
KUBECTL_ACTIVITY_GAP_SECONDS=900
# Hard cap (seconds) on one activity session's span (bounds k9s, get -w, CI polling).
# Must be >= KUBECTL_ACTIVITY_GAP_SECONDS, and the gap must be > 0, or boot fails.
KUBECTL_ACTIVITY_MAX_SECONDS=14400
